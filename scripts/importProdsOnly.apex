// Deactivate defaults
List<Product2> defaults = [SELECT Id FROM Product2 WHERE Family = null AND IsActive = true];
for(Product2 p : defaults) p.IsActive = false;
if(!defaults.isEmpty()) update defaults;
System.debug('Deactivated ' + defaults.size() + ' defaults');

