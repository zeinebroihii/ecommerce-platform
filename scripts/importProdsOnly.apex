Database.SaveResult[] results = Database.insert(newProds, false);
Integer ok = 0; Integer fail = 0;
for(Database.SaveResult r : results) {
  if(r.isSuccess()) ok++;
  else { fail++; System.debug('FAIL: ' + r.getErrors()); }
}
System.debug('Inserted: ' + ok + ' products | Failed: ' + fail);

// Now create PricebookEntries for successfully inserted products
Id stdPbId = [SELECT Id FROM Pricebook2 WHERE IsStandard = true LIMIT 1].Id;
List<PricebookEntry> pbes = new List<PricebookEntry>();
for(Integer i = 0; i < results.size(); i++) {
  if(results[i].isSuccess()) {
    pbes.add(new PricebookEntry(
      Pricebook2Id = stdPbId,
      Product2Id   = results[i].getId(),
      UnitPrice    = newProds[i].Price__c != null ? newProds[i].Price__c : 1000,
      IsActive     = true
    ));
  }
}
Database.SaveResult[] pbeResults = Database.insert(pbes, false);
Integer pbeOk = 0; Integer pbeFail = 0;
for(Database.SaveResult r : pbeResults) {
  if(r.isSuccess()) pbeOk++;
  else { pbeFail++; System.debug('PBE FAIL: ' + r.getErrors()); }
}
System.debug('PricebookEntries: ' + pbeOk + ' created | ' + pbeFail + ' failed');
System.debug('=== IMPORT COMPLETE. Total active B2B products: ' + [SELECT COUNT() FROM Product2 WHERE IsActive = true AND Family != null]);
