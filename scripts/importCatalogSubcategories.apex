prods.add(new Product2(Name='Salesforce Net Zero Cloud — Carbon Intelligence', Family='Sustainability', Subcategory__c='carbon', ProductCode='CT-002', Price__c=72000, Brand__c='Salesforce', Rating__c=4.8, IsNew__c=false, Description='End-to-end carbon accounting, Scope 1/2/3, supplier engagement, SBTi target tracking, Energy Star integration, Einstein AI insights, CDP reporting. Annual license.', AvailabilityStatus__c='En stock', IsActive=true, Image_URL__c=imgSustain));
prods.add(new Product2(Name='Sweep Carbon Management Platform — Pro', Family='Sustainability', Subcategory__c='carbon', ProductCode='CT-003', Price__c=36000, Brand__c='Sweep', Rating__c=4.5, IsNew__c=true, Description='Real-time Scope 1/2/3 tracking, GHG Protocol & ISO 14064, supplier collaboration network, decarbonization roadmap, regulatory reporting. Annual SaaS license.', AvailabilityStatus__c='En stock', IsActive=true, Image_URL__c=imgSustain));
