# ─── Blockchain connection ─────────────────────────────────────────────────────
# Copy from blockchain/.env after deployment

# Alchemy API key (free at https://dashboard.alchemy.com)
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Polygon Amoy testnet RPC URL (built from ALCHEMY_API_KEY)
# Format: https://polygon-amoy.g.alchemy.com/v2/<key>

# ─── Platform wallet ───────────────────────────────────────────────────────────
# Private key of the server-side wallet that signs all contract transactions.
# This wallet must hold MATIC (for gas) and USDC (to fund escrows).
# Generate a dedicated wallet — never use your personal wallet here.
PLATFORM_PRIVATE_KEY=your_platform_private_key_here

# ─── Deployed contract addresses ──────────────────────────────────────────────
# Fill in after running: cd blockchain && npm run deploy:testnet
ESCROW_CONTRACT_ADDRESS=0x...
USDC_CONTRACT_ADDRESS=0x...

# ─── Security ─────────────────────────────────────────────────────────────────
# A secret token that Salesforce Named Credential sends as x-api-key header.
# Generate a random string: openssl rand -hex 32
BRIDGE_API_KEY=your_secret_api_key_here
