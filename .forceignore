# List files or directories below to ignore them when running force:source:push, force:source:pull, and force:source:status
# More information: https://developer.salesforce.com/docs/atlas.en-us.sfdx_dev.meta/sfdx_dev/sfdx_dev_exclude_source.htm
#

package.xml

# LWC configuration files
**/jsconfig.json
**/.eslintrc.json

# LWC Jest
**/__tests__/**

# Build artifacts and dependencies
**/node_modules/**

# Standard Salesforce apps - cannot be deployed via Metadata API
**/applications/standard__*.app-meta.xml

# Features not available in QA/Prod DE orgs
**/flows/NexusAgentforceRoutingFlow.flow-meta.xml
**/brandingSets/NexusBranding.brandingSet-meta.xml

# Agentforce bots - require Einstein license not in DE orgs
**/bots/**

# Standard value sets - cannot be inserted via API
**/standardValueSets/ProductFamily.standardValueSet-meta.xml

# Guest User profile - requires Experience Cloud site to exist first in target org
**/profiles/Nexus*Profile*

# Quick action with metadata issue in DE orgs
**/quickActions/Product2.New_Product.quickAction-meta.xml

# Layout referencing standard Quotes (enable Quotes in org first)
**/layouts/Opportunity-Opportunity*Layout*

