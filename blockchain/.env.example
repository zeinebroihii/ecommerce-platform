# ─── Blockchain / Hardhat ──────────────────────────────────────────────────────
# Get a free Alchemy account at https://dashboard.alchemy.com
# Create an app → select "Polygon Amoy" → copy the API key
ALCHEMY_API_KEY=your_alchemy_api_key_here

# The private key of the wallet that will DEPLOY the contract
# In MetaMask: Account → Export Private Key (testnet only, never use a real wallet)
# Do NOT include the 0x prefix here
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here

# The private key of the PLATFORM wallet (Vercel backend uses this to sign txs)
# This can be the same as DEPLOYER_PRIVATE_KEY on testnet
PLATFORM_PRIVATE_KEY=your_platform_private_key_here

# Optional: Polygonscan API key to verify the contract source on-chain
# Get free at https://polygonscan.com/apis
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# ─── After deployment — fill these in ─────────────────────────────────────────
# Address of the deployed NexusEscrow contract on Amoy
ESCROW_CONTRACT_ADDRESS=

# Address of the mock USDC contract on Amoy (deployed by deploy.js)
USDC_CONTRACT_ADDRESS=

# ─── Set to "true" to see gas costs per function in tests ─────────────────────
REPORT_GAS=false
