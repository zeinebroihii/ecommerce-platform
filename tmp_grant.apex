ApexClass cls = [SELECT Id FROM ApexClass WHERE Name = 'TestimonialController' LIMIT 1]; Profile p = [SELECT Id FROM Profile WHERE Name = 'Nexus Profile' LIMIT 1]; List<SetupEntityAccess> existing = [SELECT Id FROM SetupEntityAccess WHERE SetupEntityId = :cls.Id AND ParentId IN (SELECT Id FROM PermissionSet WHERE ProfileId = :p.Id) LIMIT 1]; if(existing.isEmpty()){ SetupEntityAccess sea = new SetupEntityAccess(SetupEntityId = cls.Id, ParentId = [SELECT Id FROM PermissionSet WHERE ProfileId = :p.Id AND IsOwnedByProfile = true LIMIT 1].Id); insert sea; System.debug('Access granted'); } else { System.debug('Already granted'); }
