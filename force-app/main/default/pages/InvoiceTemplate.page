<!-- InvoiceTemplate.page — Nexus Commerce PDF Invoice -->
<apex:page
  controller="InvoiceController"
  renderAs="pdf"
  showHeader="false"
  sidebar="false"
  standardStylesheets="false"
>
  <head>
    <style>
      body {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 11px;
        color: #1e293b;
        background: #fff;
        padding: 0;
        margin: 0;
      }

      /* ── HEADER ── */
      .inv-header {
        background-color: #0f172a;
        padding: 32px 40px 28px 40px;
        overflow: hidden;
      }
      .inv-brand {
        float: left;
      }
      .inv-logo-wrap {
        overflow: hidden;
        margin-bottom: 10px;
      }
      .inv-logo-box {
        float: left;
        width: 44px;
        height: 44px;
        background-color: #4f46e5;
        border-radius: 10px;
        text-align: center;
        font-size: 22px;
        font-weight: 900;
        color: #ffffff;
        line-height: 44px;
        margin-right: 12px;
      }
      .inv-brand-text {
        float: left;
        padding-top: 4px;
      }
      .inv-brand-title {
        font-size: 18px;
        font-weight: 900;
        color: #ffffff;
        letter-spacing: -0.02em;
        line-height: 1.1;
      }
      .inv-brand-sub {
        font-size: 8px;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        margin-top: 2px;
      }
      .inv-brand-addr {
        font-size: 9px;
        color: #64748b;
        line-height: 1.7;
        clear: both;
        padding-top: 6px;
      }
      .inv-meta {
        float: right;
        text-align: right;
      }
      .inv-meta-label {
        font-size: 28px;
        font-weight: 900;
        color: #ffffff;
        letter-spacing: 0.1em;
      }
      .inv-meta-number {
        font-size: 13px;
        font-weight: 700;
        color: #818cf8;
        margin-top: 6px;
      }
      .inv-meta-row {
        font-size: 9px;
        color: #94a3b8;
        margin-top: 4px;
      }
      .inv-meta-row strong {
        color: #cbd5e1;
      }
      .inv-status-badge {
        display: inline-block;
        margin-top: 10px;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 8px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        background-color: #312e81;
        color: #a5b4fc;
      }

      /* Accent bars */
      .inv-bar-indigo {
        height: 4px;
        background-color: #4f46e5;
      }
      .inv-bar-emerald {
        height: 2px;
        background-color: #10b981;
      }

      /* ── BODY ── */
      .inv-body {
        padding: 28px 40px;
      }

      /* Info row */
      .inv-info-row {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        padding: 14px 18px;
        margin-bottom: 24px;
        overflow: hidden;
      }
      .inv-info-cell {
        float: left;
        width: 25%;
      }
      .inv-info-lbl {
        font-size: 7px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: #94a3b8;
        margin-bottom: 4px;
      }
      .inv-info-val {
        font-size: 11px;
        font-weight: 700;
        color: #0f172a;
      }
      .inv-info-val-indigo {
        font-size: 11px;
        font-weight: 700;
        color: #4f46e5;
      }
      .inv-info-val-green {
        font-size: 11px;
        font-weight: 700;
        color: #10b981;
      }

      /* Addresses */
      .inv-addresses {
        overflow: hidden;
        margin-bottom: 24px;
        padding-bottom: 20px;
        border-bottom: 1px solid #e2e8f0;
      }
      .inv-addr-left {
        float: left;
        width: 48%;
      }
      .inv-addr-right {
        float: right;
        width: 48%;
      }
      .inv-addr-eyebrow {
        font-size: 7px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: #4f46e5;
        margin-bottom: 8px;
        border-bottom: 2px solid #4f46e5;
        padding-bottom: 4px;
        display: block;
      }
      .inv-addr-name {
        font-size: 13px;
        font-weight: 900;
        color: #0f172a;
        margin-bottom: 5px;
      }
      .inv-addr-line {
        font-size: 10px;
        color: #64748b;
        line-height: 1.9;
      }

      /* Section title */
      .inv-section-title {
        font-size: 7px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: #94a3b8;
        margin-bottom: 8px;
      }

      /* Items table */
      table.inv-items {
        width: 100%;
        border-collapse: collapse;
      }
      table.inv-items thead tr {
        background-color: #0f172a;
      }
      table.inv-items thead th {
        padding: 10px 12px;
        font-size: 8px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #94a3b8;
        text-align: left;
      }
      table.inv-items thead th.r {
        text-align: right;
      }
      table.inv-items tbody tr {
        border-bottom: 1px solid #f1f5f9;
      }
      table.inv-items tbody tr.even {
        background-color: #f8fafc;
      }
      table.inv-items tbody td {
        padding: 11px 12px;
        font-size: 10px;
        color: #334155;
      }
      table.inv-items tbody td.r {
        text-align: right;
        font-weight: 700;
        color: #0f172a;
      }
      .inv-prod-name {
        font-size: 11px;
        font-weight: 700;
        color: #0f172a;
      }
      .inv-prod-cat {
        font-size: 8px;
        color: #94a3b8;
        margin-top: 2px;
      }
      .inv-qty-pill {
        background: #ede9fe;
        color: #4f46e5;
        padding: 2px 8px;
        border-radius: 20px;
        font-size: 9px;
        font-weight: 900;
      }

      /* Totals */
      .inv-totals-outer {
        overflow: hidden;
        margin-top: 20px;
      }
      .inv-totals-right {
        float: right;
        width: 46%;
      }
      table.inv-totals {
        width: 100%;
        border-collapse: collapse;
      }
      table.inv-totals td {
        padding: 6px 2px;
        font-size: 10px;
        color: #64748b;
      }
      table.inv-totals td.lbl {
        text-align: left;
      }
      table.inv-totals td.amt {
        text-align: right;
        font-weight: 700;
        color: #334155;
      }
      table.inv-totals td.sparks-lbl {
        color: #7c3aed;
        font-weight: 700;
      }
      table.inv-totals td.sparks-amt {
        text-align: right;
        font-weight: 900;
        color: #10b981;
      }
      table.inv-totals td.divider-cell {
        border-top: 2px solid #0f172a;
        padding-top: 10px;
      }
      table.inv-totals td.grand-lbl {
        font-size: 13px;
        font-weight: 900;
        color: #0f172a;
        border-top: 2px solid #0f172a;
        padding-top: 10px;
      }
      table.inv-totals td.grand-amt {
        font-size: 20px;
        font-weight: 900;
        color: #4f46e5;
        text-align: right;
        letter-spacing: -0.02em;
        border-top: 2px solid #0f172a;
        padding-top: 10px;
      }

      /* Footer */
      .inv-footer {
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
        padding: 18px 40px;
        overflow: hidden;
        margin-top: 36px;
      }
      .inv-footer-left {
        float: left;
      }
      .inv-footer-right {
        float: right;
        text-align: right;
      }
      .inv-thanks {
        font-size: 12px;
        font-weight: 900;
        color: #0f172a;
        margin-bottom: 4px;
      }
      .inv-footer-note {
        font-size: 8px;
        color: #94a3b8;
        line-height: 1.7;
      }
      .inv-footer-brand {
        font-size: 10px;
        font-weight: 900;
        color: #4f46e5;
        margin-bottom: 4px;
      }
      .inv-footer-contact {
        font-size: 8px;
        color: #94a3b8;
        line-height: 1.7;
      }
    </style>
  </head>
  <body>
    <!-- HEADER -->
    <div class="inv-header">
      <div class="inv-brand">
        <div class="inv-logo-wrap">
          <div class="inv-logo-box">N</div>
          <div class="inv-brand-text">
            <div class="inv-brand-title">NEXUS</div>
            <div class="inv-brand-sub">Commerce Platform</div>
          </div>
        </div>
        <div class="inv-brand-addr">
          12 Innovation Drive, Paris, France 75001<br />
          support@nexus-commerce.com &nbsp;·&nbsp; nexus-commerce.com
        </div>
      </div>
      <div class="inv-meta">
        <div class="inv-meta-label">INVOICE</div>
        <div class="inv-meta-number">INV-{!ord.OrderNumber}</div>
        <div class="inv-meta-row"><strong>Date:</strong> {!formattedDate}</div>
        <div class="inv-meta-row">
          <strong>Order #:</strong> {!ord.OrderNumber}
        </div>
        <div class="inv-status-badge">{!ord.Status}</div>
      </div>
    </div>

    <div class="inv-bar-indigo"></div>
    <div class="inv-bar-emerald"></div>

    <!-- BODY -->
    <div class="inv-body">
      <!-- Order info strip -->
      <div class="inv-info-row">
        <div class="inv-info-cell">
          <div class="inv-info-lbl">Invoice Number</div>
          <div class="inv-info-val-indigo">INV-{!ord.OrderNumber}</div>
        </div>
        <div class="inv-info-cell">
          <div class="inv-info-lbl">Issue Date</div>
          <div class="inv-info-val">{!formattedDate}</div>
        </div>
        <div class="inv-info-cell">
          <div class="inv-info-lbl">Order Status</div>
          <div class="inv-info-val">{!ord.Status}</div>
        </div>
        <div class="inv-info-cell">
          <div class="inv-info-lbl">Payment</div>
          <div class="inv-info-val-green">Confirmed ✓</div>
        </div>
      </div>

      <!-- Addresses -->
      <div class="inv-addresses">
        <div class="inv-addr-left">
          <span class="inv-addr-eyebrow">Billed To</span>
          <div class="inv-addr-name">{!ord.Account.Name}</div>
          <div class="inv-addr-line">
            {!ord.Account.BillingStreet}<br /> {!ord.Account.BillingCity},
            {!ord.Account.BillingState}<br />
            {!ord.Account.BillingPostalCode} — {!ord.Account.BillingCountry}
          </div>
        </div>
        <div class="inv-addr-right">
          <span class="inv-addr-eyebrow">Shipped To</span>
          <div class="inv-addr-name">{!ord.Account.Name}</div>
          <div class="inv-addr-line">
            {!ord.Shipping_Street__c}<br /> {!ord.Shipping_City__c},
            {!ord.Shipping_State__c}<br />
            {!ord.Shipping_Zip__c} — {!ord.Shipping_Country__c}
          </div>
        </div>
      </div>

      <!-- Line Items -->
      <div class="inv-section-title">Order Items</div>
      <table class="inv-items">
        <thead>
          <tr>
            <th style="width: 42%">Product</th>
            <th style="width: 20%">Category</th>
            <th class="r" style="width: 10%">Qty</th>
            <th class="r" style="width: 14%">Unit Price</th>
            <th class="r" style="width: 14%">Total</th>
          </tr>
        </thead>
        <tbody>
          <apex:repeat value="{!ord.OrderItems}" var="item">
            <tr>
              <td>
                <div class="inv-prod-name">{!item.Product2.Name}</div>
                <div class="inv-prod-cat">{!item.Product2.Family}</div>
              </td>
              <td style="color: #94a3b8; font-size: 10px">
                {!item.Product2.Family}
              </td>
              <td class="r">
                <span class="inv-qty-pill">{!item.Quantity}</span>
              </td>
              <td class="r">
                <apex:outputText value="{0,number,#,##0.00}">
                  <apex:param value="{!item.UnitPrice}" />
                </apex:outputText>
                €
              </td>
              <td class="r">
                <apex:outputText value="{0,number,#,##0.00}">
                  <apex:param value="{!item.TotalPrice}" />
                </apex:outputText>
                €
              </td>
            </tr>
          </apex:repeat>
        </tbody>
      </table>

      <!-- Totals -->
      <div class="inv-totals-outer">
        <div class="inv-totals-right">
          <table class="inv-totals">
            <tr>
              <td class="lbl">Subtotal</td>
              <td class="amt">
                <apex:outputText value="{0,number,#,##0.00}">
                  <apex:param value="{!subtotal}" />
                </apex:outputText>
                €
              </td>
            </tr>
            <tr>
              <td class="lbl">Shipping</td>
              <td class="amt">{!formattedShipping}</td>
            </tr>
            <apex:outputPanel rendered="{!hasSparksDiscount}" layout="none">
              <tr>
                <td class="lbl sparks-lbl">&#x2736; Sparks Discount</td>
                <td class="amt sparks-amt">
                  -<apex:outputText value="{0,number,#,##0.00}">
                    <apex:param value="{!sparksDiscount}" />
                  </apex:outputText>
                  €
                </td>
              </tr>
            </apex:outputPanel>
            <tr>
              <td class="grand-lbl">Grand Total</td>
              <td class="grand-amt">
                <apex:outputText value="{0,number,#,##0.00}">
                  <apex:param value="{!ord.TotalAmount}" />
                </apex:outputText>
                €
              </td>
            </tr>
          </table>
        </div>
      </div>
    </div>

    <!-- FOOTER -->
    <div class="inv-footer">
      <div class="inv-footer-left">
        <div class="inv-thanks">Thank you for your business!</div>
        <div class="inv-footer-note">
          This is an automatically generated invoice. Please retain it for your
          records.<br />
          Payment confirmed — no further action required.
        </div>
      </div>
      <div class="inv-footer-right">
        <div class="inv-footer-brand">NEXUS COMMERCE</div>
        <div class="inv-footer-contact">
          support@nexus-commerce.com<br /> 12 Innovation Drive, Paris 75001<br />
          nexus-commerce.com
        </div>
      </div>
    </div>
  </body>
</apex:page>
