<!-- InvoiceTemplate.page
     Renders as a PDF invoice attached to the Order.
     Called by InvoiceService when an Order is shipped.
-->
<apex:page controller="InvoiceController"
           renderAs="pdf"
           showHeader="false"
           sidebar="false"
           standardStylesheets="false">

<head>
<style>
    body {
        font-family: Arial, sans-serif;
        font-size: 12px;
        color: #333;
        margin: 0;
        padding: 20px;
    }
    .invoice-header {
        border-bottom: 3px solid #1d8348;
        padding-bottom: 20px;
        margin-bottom: 20px;
        overflow: hidden;
    }
    .company-name {
        font-size: 24px;
        font-weight: bold;
        color: #1d8348;
        float: left;
    }
    .invoice-meta {
        float: right;
        text-align: right;
    }
    .invoice-meta h2 {
        font-size: 28px;
        color: #1d8348;
        margin: 0;
    }
    .invoice-meta p { margin: 2px 0; }
    .addresses {
        overflow: hidden;
        margin-bottom: 25px;
    }
    .bill-to, .ship-to {
        float: left;
        width: 45%;
    }
    .ship-to { float: right; }
    .section-label {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #888;
        margin-bottom: 5px;
    }
    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }
    thead tr {
        background-color: #1d8348;
        color: white;
    }
    thead th {
        padding: 10px 8px;
        text-align: left;
    }
    tbody tr:nth-child(even) { background-color: #f9f9f9; }
    tbody td { padding: 8px; border-bottom: 1px solid #eee; }
    .text-right { text-align: right; }
    .total-row {
        border-top: 2px solid #1d8348;
        font-weight: bold;
        font-size: 14px;
    }
    .footer {
        margin-top: 30px;
        border-top: 1px solid #eee;
        padding-top: 15px;
        font-size: 10px;
        color: #888;
        text-align: center;
    }
</style>
</head>

<body>

<!-- Header -->
<div class="invoice-header">
    <div class="company-name">E-Commerce Store</div>
    <div class="invoice-meta">
        <h2>INVOICE</h2>
        <p><strong>Invoice #:</strong> INV-{!ord.OrderNumber}</p>
        <p><strong>Date:</strong> {!formattedDate}</p>
        <p><strong>Status:</strong> {!ord.Status}</p>
    </div>
</div>

<!-- Addresses -->
<div class="addresses">
    <div class="bill-to">
        <div class="section-label">Bill To</div>
        <strong>{!ord.Account.Name}</strong><br/>
        {!ord.Account.BillingStreet}<br/>
        {!ord.Account.BillingCity}, {!ord.Account.BillingState}<br/>
        {!ord.Account.BillingPostalCode}<br/>
        {!ord.Account.BillingCountry}
    </div>

    <div class="ship-to">
        <div class="section-label">Ship To</div>
        <strong>{!ord.Account.Name}</strong><br/>
        {!ord.Shipping_Street__c}<br/>
        {!ord.Shipping_City__c}, {!ord.Shipping_State__c}<br/>
        {!ord.Shipping_Zip__c}<br/>
        {!ord.Shipping_Country__c}
    </div>
</div>

<!-- Line Items Table -->
<table>
    <thead>
        <tr>
            <th>Product</th>
            <th>Category</th>
            <th class="text-right">Qty</th>
            <th class="text-right">Unit Price</th>
            <th class="text-right">Total</th>
        </tr>
    </thead>
    <tbody>
        <apex:repeat value="{!ord.OrderItems}" var="item">
            <tr>
                <td>{!item.Product2.Name}</td>
                <td>{!item.Product2.Family}</td>
                <td class="text-right">{!item.Quantity}</td>
                <td class="text-right">£<apex:outputText value="{0,number,#,##0.00}">
                    <apex:param value="{!item.UnitPrice}"/>
                </apex:outputText></td>
                <td class="text-right">£<apex:outputText value="{0,number,#,##0.00}">
                    <apex:param value="{!item.TotalPrice}"/>
                </apex:outputText></td>
            </tr>
        </apex:repeat>

        <!-- Total row -->
        <tr class="total-row">
            <td colspan="4" class="text-right">ORDER TOTAL</td>
            <td class="text-right">£<apex:outputText value="{0,number,#,##0.00}">
                <apex:param value="{!ord.TotalAmount}"/>
            </apex:outputText></td>
        </tr>
    </tbody>
</table>

<!-- Footer -->
<div class="footer">
    <p>Thank you for your order! Questions? Contact support@ecommercestore.com</p>
    <p>This is an automatically generated invoice. Please retain for your records.</p>
</div>

</body>
</apex:page>
