<!-- InvoiceTemplate.page — Nexus v7 single-page compact -->
<apex:page
  controller="InvoiceController"
  renderAs="pdf"
  showHeader="false"
  sidebar="false"
  standardStylesheets="false"
>
  <head>
    <style>
      @page {
        size: A4;
        margin: 0;
      }

      body {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 9px;
        color: #0f172a;
        background: #ffffff;
        margin: 0;
        padding: 0;
      }
      table {
        border-collapse: collapse;
      }
      td,
      th {
        padding: 0;
        margin: 0;
      }

      .lbl {
        font-size: 7px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #94a3b8;
      }
      .val {
        font-size: 10px;
        font-weight: bold;
        color: #0f172a;
      }

      /* LOGO */
      .logo-n {
        background-color: #0f172a;
        width: 38px;
        height: 38px;
        text-align: center;
        vertical-align: middle;
        font-size: 18px;
        font-weight: bold;
        color: #34d399;
      }
      .logo-name {
        font-size: 18px;
        font-weight: bold;
        font-style: italic;
        text-transform: uppercase;
        color: #0f172a;
        line-height: 1.1;
        letter-spacing: -1px;
      }
      .logo-sub {
        font-size: 6px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: #059669;
        margin-top: 1px;
      }

      .inv-title {
        font-size: 36px;
        font-weight: bold;
        font-style: italic;
        text-transform: uppercase;
        color: #0f172a;
        line-height: 1;
        letter-spacing: -2px;
      }
      .badge {
        background-color: #dcfce7;
        color: #166534;
        font-size: 7px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 3px 10px;
      }

      .from-name {
        font-size: 10px;
        font-weight: bold;
        color: #0f172a;
      }
      .addr-line {
        font-size: 8px;
        font-weight: bold;
        color: #64748b;
        line-height: 1.8;
      }

      .bill-lbl {
        font-size: 7px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #94a3b8;
        margin-bottom: 5px;
      }
      .bill-name {
        font-size: 10px;
        font-weight: bold;
        color: #0f172a;
        margin-bottom: 3px;
      }
      .bill-addr {
        font-size: 8px;
        font-weight: bold;
        color: #64748b;
        line-height: 1.75;
      }

      .th {
        font-size: 7px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #94a3b8;
        padding-bottom: 8px;
        border-bottom: 2px solid #0f172a;
        text-align: left;
      }
      .th-r {
        text-align: right;
      }
      .th-c {
        text-align: center;
      }

      .item-name {
        font-size: 10px;
        font-weight: bold;
        color: #0f172a;
      }
      .item-sku {
        font-size: 6px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #94a3b8;
        margin-top: 2px;
      }
      .qty-box {
        background-color: #f1f5f9;
        color: #0f172a;
        padding: 2px 8px;
        font-size: 9px;
        font-weight: bold;
      }

      .td-r {
        text-align: right;
        font-weight: bold;
        color: #0f172a;
        font-size: 10px;
      }
      .td-m {
        text-align: right;
        font-weight: bold;
        color: #64748b;
        font-size: 10px;
      }
      .td-c {
        text-align: center;
      }

      .pay-box {
        background-color: #ecfdf5;
        padding: 10px 12px;
      }
      .pay-title {
        font-size: 7px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #14532d;
        margin-bottom: 3px;
      }
      .pay-text {
        font-size: 8px;
        font-weight: bold;
        color: #166534;
        line-height: 1.6;
      }

      .tot-lbl {
        font-size: 7px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #94a3b8;
        padding: 4px 0;
      }
      .tot-amt {
        text-align: right;
        font-weight: bold;
        color: #0f172a;
        padding: 4px 0;
        font-size: 10px;
      }
      .tot-free {
        text-align: right;
        font-weight: bold;
        font-style: italic;
        color: #059669;
        padding: 4px 0;
        font-size: 10px;
      }

      .due-lbl {
        font-size: 8px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #0f172a;
      }
      .due-sub {
        font-size: 7px;
        font-weight: bold;
        color: #94a3b8;
        margin-top: 2px;
      }
      .due-num {
        font-size: 24px;
        font-weight: bold;
        font-style: italic;
        color: #0f172a;
        text-align: right;
        line-height: 1;
        letter-spacing: -1px;
      }

      .ft-bg {
        background-color: #ffffff;
      }
      .ft-brand {
        font-size: 12px;
        font-weight: bold;
        font-style: italic;
        text-transform: uppercase;
        color: #0f172a;
        letter-spacing: -1px;
      }
      .ft-note {
        font-size: 7px;
        font-weight: bold;
        color: #64748b;
        line-height: 1.7;
      }
      .ft-hl {
        color: #0f172a;
      }
      .ft-link {
        color: #059669;
      }
      .ft-clbl {
        font-size: 6px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: #94a3b8;
        margin-bottom: 5px;
      }
      .ft-cval {
        font-size: 8px;
        font-weight: bold;
        color: #475569;
        line-height: 1.8;
      }
      .ft-copy {
        font-size: 6px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #94a3b8;
      }
      .ft-links {
        font-size: 6px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #64748b;
        text-align: right;
      }
    </style>
  </head>
  <body>
    <!-- TOP BAR -->
    <table width="100%">
      <tr>
        <td
          width="30%"
          style="height: 8px; background-color: #0f172a; font-size: 1px"
        >
          &#160;
        </td>
        <td
          width="40%"
          style="height: 8px; background-color: #059669; font-size: 1px"
        >
          &#160;
        </td>
        <td
          width="30%"
          style="height: 8px; background-color: #0f172a; font-size: 1px"
        >
          &#160;
        </td>
      </tr>
    </table>

    <!-- HEADER -->
    <table width="100%">
      <tr>
        <td width="36" style="font-size: 1px">&#160;</td>
        <td style="padding-top: 28px; padding-bottom: 22px">
          <table width="100%">
            <tr>
              <!-- LEFT -->
              <td width="44%" style="vertical-align: top; padding-right: 16px">
                <!-- Logo -->
                <table style="margin-bottom: 16px">
                  <tr>
                    <td class="logo-n" style="width: 38px; height: 38px">N</td>
                    <td style="padding-left: 8px; vertical-align: middle">
                      <div class="logo-name">Nexus</div>
                      <div class="logo-sub">Commerce</div>
                    </td>
                  </tr>
                </table>
                <!-- From -->
                <div class="lbl" style="margin-bottom: 4px">From</div>
                <div class="from-name">Nexus Commerce SAS</div>
                <div class="addr-line" style="margin-top: 2px">
                  12 Innovation Drive, Paris, France 75001
                </div>
                <div class="addr-line">
                  support@nexus-commerce.com &#160;·&#160; nexus-commerce.com
                </div>
              </td>

              <!-- RIGHT -->
              <td width="56%" style="vertical-align: top; text-align: right">
                <div class="inv-title">Invoice</div>
                <div style="margin-top: 6px; margin-bottom: 14px">
                  <span class="badge">&#10003; Paid</span>
                </div>
                <div class="lbl" style="margin-bottom: 2px">Invoice Number</div>
                <div class="val" style="margin-bottom: 8px">
                  INV-{!ord.OrderNumber}
                </div>
                <div class="lbl" style="margin-bottom: 2px">Date of Issue</div>
                <div class="val" style="margin-bottom: 8px">
                  {!formattedDate}
                </div>
                <div class="lbl" style="margin-bottom: 2px">
                  Order Reference
                </div>
                <div class="val">#{!ord.OrderNumber}</div>
              </td>
            </tr>
          </table>
        </td>
        <td width="36" style="font-size: 1px">&#160;</td>
      </tr>
    </table>

    <!-- BILL TO / SHIP TO -->
    <table width="100%">
      <tr>
        <td width="36" style="font-size: 1px">&#160;</td>
        <td>
          <table
            width="100%"
            style="background-color: #f8fafc; border: 1px solid #e2e8f0"
          >
            <tr>
              <td
                width="50%"
                style="vertical-align: top; padding: 16px 16px 16px 18px"
              >
                <div class="bill-lbl">Bill To</div>
                <div class="bill-name">{!ord.Account.Name}</div>
                <div class="bill-addr">
                  {!ord.Account.BillingStreet}<br />
                  {!ord.Account.BillingCity}<apex:outputPanel
                    rendered="{!NOT(ISBLANK(ord.Account.BillingState))}"
                    >, {!ord.Account.BillingState}</apex:outputPanel
                  >
                  &#160; {!ord.Account.BillingPostalCode}<apex:outputPanel
                    rendered="{!NOT(ISBLANK(ord.Account.BillingCountry))}"
                    >, {!ord.Account.BillingCountry}</apex:outputPanel
                  >
                </div>
              </td>
              <td
                width="50%"
                style="
                  vertical-align: top;
                  padding: 16px 18px 16px 16px;
                  border-left: 1px solid #e2e8f0;
                "
              >
                <div class="bill-lbl">Ship To</div>
                <div class="bill-name">{!ord.Account.Name}</div>
                <div class="bill-addr">
                  {!ord.Shipping_Street__c}<br />
                  {!ord.Shipping_City__c}<apex:outputPanel
                    rendered="{!NOT(ISBLANK(ord.Shipping_State__c))}"
                    >, {!ord.Shipping_State__c}</apex:outputPanel
                  >
                  &#160; {!ord.Shipping_Zip__c}<apex:outputPanel
                    rendered="{!NOT(ISBLANK(ord.Shipping_Country__c))}"
                    >, {!ord.Shipping_Country__c}</apex:outputPanel
                  >
                </div>
              </td>
            </tr>
          </table>
        </td>
        <td width="36" style="font-size: 1px">&#160;</td>
      </tr>
    </table>

    <!-- LINE ITEMS -->
    <table width="100%" style="margin-top: 22px">
      <tr>
        <td width="36" style="font-size: 1px">&#160;</td>
        <td>
          <table width="100%">
            <thead>
              <tr>
                <th class="th" width="46%" style="padding-right: 10px">
                  Description
                </th>
                <th class="th th-c" width="12%">Qty</th>
                <th class="th th-r" width="21%">Unit Price</th>
                <th class="th th-r" width="21%">Amount</th>
              </tr>
            </thead>
            <tbody>
              <apex:repeat value="{!ord.OrderItems}" var="item">
                <tr>
                  <td
                    style="
                      padding: 11px 10px 11px 0;
                      border-bottom: 1px solid #f1f5f9;
                      vertical-align: middle;
                    "
                  >
                    <div class="item-name">{!item.Product2.Name}</div>
                    <div class="item-sku">
                      SKU: {!item.Product2.ProductCode}
                    </div>
                  </td>
                  <td
                    class="td-c"
                    style="
                      padding: 11px 0;
                      border-bottom: 1px solid #f1f5f9;
                      vertical-align: middle;
                    "
                  >
                    <span class="qty-box">{!item.Quantity}</span>
                  </td>
                  <td
                    class="td-m"
                    style="
                      padding: 11px 0;
                      border-bottom: 1px solid #f1f5f9;
                      vertical-align: middle;
                    "
                  >
                    <apex:outputText value="{0,number,#,##0.00}"
                      ><apex:param value="{!item.UnitPrice}"
                    /></apex:outputText>
                    &#8364;
                  </td>
                  <td
                    class="td-r"
                    style="
                      padding: 11px 0;
                      border-bottom: 1px solid #f1f5f9;
                      vertical-align: middle;
                    "
                  >
                    <apex:outputText value="{0,number,#,##0.00}"
                      ><apex:param value="{!item.TotalPrice}"
                    /></apex:outputText>
                    &#8364;
                  </td>
                </tr>
              </apex:repeat>
            </tbody>
          </table>
        </td>
        <td width="36" style="font-size: 1px">&#160;</td>
      </tr>
    </table>

    <!-- SUMMARY -->
    <table width="100%" style="margin-top: 20px; border-top: 2px solid #f1f5f9">
      <tr>
        <td width="36" style="font-size: 1px">&#160;</td>
        <td style="padding-top: 18px">
          <table width="100%">
            <tr>
              <!-- left: payment box + notes -->
              <td width="46%" style="vertical-align: top; padding-right: 20px">
                <div class="pay-box" style="margin-bottom: 14px">
                  <div class="pay-title">&#10003; Payment Status</div>
                  <div class="pay-text">
                    Payment confirmed &#8212; no further action required.
                  </div>
                </div>
                <div class="lbl" style="margin-bottom: 5px">Notes</div>
                <div class="addr-line">
                  Payment due within 30 days. Late payments subject to 1.5%
                  monthly interest. Ref: INV-{!ord.OrderNumber}
                </div>
              </td>

              <!-- right: totals -->
              <td width="46%" style="vertical-align: top">
                <table width="100%">
                  <tr>
                    <td class="tot-lbl">Subtotal</td>
                    <td class="tot-amt">
                      <apex:outputText value="{0,number,#,##0.00}"
                        ><apex:param value="{!subtotal}"
                      /></apex:outputText>
                      &#8364;
                    </td>
                  </tr>
                  <tr>
                    <td class="tot-lbl">Shipping</td>
                    <td class="tot-free">Free</td>
                  </tr>
                  <tr>
                    <td class="tot-lbl">VAT (B2B exempt)</td>
                    <td class="tot-amt">&#8212;</td>
                  </tr>
                  <apex:outputPanel
                    rendered="{!hasSparksDiscount}"
                    layout="none"
                  >
                    <tr>
                      <td class="tot-lbl" style="color: #7c3aed">
                        &#x2736; Sparks
                      </td>
                      <td
                        class="tot-amt"
                        style="color: #10b981; text-align: right"
                      >
                        -<apex:outputText value="{0,number,#,##0.00}"
                          ><apex:param value="{!sparksDiscount}"
                        /></apex:outputText>
                        &#8364;
                      </td>
                    </tr>
                  </apex:outputPanel>
                </table>
                <table
                  width="100%"
                  style="margin-top: 6px; border-top: 2px solid #0f172a"
                >
                  <tr>
                    <td style="vertical-align: top; padding-top: 10px">
                      <div class="due-lbl">Amount Due</div>
                      <div class="due-sub">Due {!formattedDate}</div>
                    </td>
                    <td
                      class="due-num"
                      style="padding-top: 10px; vertical-align: middle"
                    >
                      <apex:outputText value="{0,number,#,##0.00}"
                        ><apex:param value="{!ord.TotalAmount}"
                      /></apex:outputText>
                      &#8364;
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
        <td width="36" style="font-size: 1px">&#160;</td>
      </tr>
    </table>

    <!-- FOOTER -->
    <table
      width="100%"
      style="
        margin-top: 28px;
        background-color: #ffffff;
        border-top: 2px solid #e2e8f0;
      "
    >
      <tr>
        <td width="36" style="font-size: 1px">&#160;</td>
        <td style="padding: 22px 0 18px">
          <!-- brand row with N logo -->
          <table style="margin-bottom: 10px">
            <tr>
              <td
                style="
                  background-color: #0f172a;
                  width: 28px;
                  height: 28px;
                  text-align: center;
                  vertical-align: middle;
                  font-size: 13px;
                  font-weight: bold;
                  color: #34d399;
                  padding: 0;
                "
              >
                N
              </td>
              <td
                style="padding-left: 8px; vertical-align: middle"
                class="ft-brand"
              >
                Nexus Commerce SAS
              </td>
            </tr>
          </table>

          <div class="ft-note" style="margin-bottom: 16px">
            Please reference
            <span class="ft-hl">INV-{!ord.OrderNumber}</span> in all
            correspondence. For billing enquiries:
            <span class="ft-link">support@nexus-commerce.com</span>
          </div>

          <table width="100%" style="margin-bottom: 18px">
            <tr>
              <td width="33%" style="vertical-align: top">
                <div class="ft-clbl">Address</div>
                <div class="ft-cval">
                  12 Innovation Drive<br />Paris, France 75001
                </div>
              </td>
              <td width="33%" style="vertical-align: top">
                <div class="ft-clbl">Tax Info</div>
                <div class="ft-cval">
                  VAT: FR00 000 000 000<br />SIRET: 123 456 789 00012
                </div>
              </td>
              <td width="34%">&#160;</td>
            </tr>
          </table>

          <table width="100%" style="border-top: 1px solid #1e293b">
            <tr>
              <td style="padding-top: 10px" class="ft-copy">
                &#169; 2026 Nexus Commerce. All rights reserved.
              </td>
              <td style="padding-top: 10px" class="ft-links">
                Terms of Service&#160;&#160;&#160;Privacy Policy
              </td>
            </tr>
          </table>
        </td>
        <td width="36" style="font-size: 1px">&#160;</td>
      </tr>
    </table>
  </body>
</apex:page>
