<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <hasActivationRequired>false</hasActivationRequired>
    <label>Nexus Agentforce Actions</label>
    <description>Grants EinsteinServiceAgent profile access to all Nexus quote negotiation Apex actions required by Agentforce.</description>
    <classAccesses>
        <apexClass>NexusQuoteNegotiateAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>NexusQuoteCounterAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>NexusQuoteGetAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>NexusQuoteAcceptAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>NexusQuoteRejectAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>NexusQuoteEscalateAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>QuoteController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>NexusQuoteController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
