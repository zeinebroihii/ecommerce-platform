<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <description>Listens for Low_Stock_Alert__e platform events. Creates a Purchase Order for restocking when stock falls below threshold.</description>
    <label>Low Stock - Create Purchase Order</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>

    <!--
        FIX: <triggerType> belongs INSIDE <start>, not at root <Flow> level.
        Platform Event flows use triggerType=PlatformEvent inside <start>.
    -->
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Stock_Record</targetReference>
        </connector>
        <object>Low_Stock_Alert__e</object>
        <triggerType>PlatformEvent</triggerType>
    </start>

    <!-- Get the Stock record so we can read the reorder threshold -->
    <recordLookups>
        <name>Get_Stock_Record</name>
        <label>Get Stock Record</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_Purchase_Order</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Product__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Product_Id__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Stock__c</object>
        <outputReference>varStockRecord</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Product__c</queriedFields>
        <queriedFields>Reorder_Threshold__c</queriedFields>
        <queriedFields>Quantity_Available__c</queriedFields>
    </recordLookups>

    <!-- Create a Purchase Order: reorder 3x the threshold quantity -->
    <recordCreates>
        <name>Create_Purchase_Order</name>
        <label>Create Purchase Order</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <inputAssignments>
            <field>Product__c</field>
            <value>
                <elementReference>varStockRecord.Product__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Quantity_Requested__c</field>
            <value>
                <elementReference>reorderQty</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Draft</stringValue>
            </value>
        </inputAssignments>
        <object>Purchase_Order__c</object>
    </recordCreates>

    <!-- Formula: reorder qty = 3x the threshold -->
    <formulas>
        <name>reorderQty</name>
        <dataType>Number</dataType>
        <expression>{!varStockRecord.Reorder_Threshold__c} * 3</expression>
        <scale>0</scale>
    </formulas>

    <!-- Variable to hold the queried Stock record -->
    <variables>
        <name>varStockRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Stock__c</objectType>
    </variables>

</Flow>
