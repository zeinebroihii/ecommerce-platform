<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description
  >Before-Save flow on Order Update. When Status changes to Shipped, stamps Shipped_Date__c. When Status changes to Delivered or Completed, stamps Delivered_Date__c.</description>
    <label>Nexus Order Status Date Stamp</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>

    <!-- ── Start: Before-Save, Update only, no filter (Decision handles status logic) ── -->
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_New_Status</targetReference>
        </connector>
        <object>Order</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>

    <!-- ── Decision: which status? ─────────────────────────────────────────── -->
    <decisions>
        <name>Check_New_Status</name>
        <label>Check New Status</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <defaultConnectorLabel>Other (do nothing)</defaultConnectorLabel>
        <rules>
            <name>Is_Shipped</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Shipped</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Stamp_Shipped_Date</targetReference>
            </connector>
            <label>Shipped</label>
        </rules>
        <rules>
            <name>Is_Delivered_Or_Completed</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Delivered</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Stamp_Delivered_Date</targetReference>
            </connector>
            <label>Delivered or Completed</label>
        </rules>
    </decisions>

    <!-- ── Assignment: set Shipped_Date__c = now ────────────────────────────── -->
    <assignments>
        <name>Stamp_Shipped_Date</name>
        <label>Stamp Shipped Date</label>
        <locationX>56</locationX>
        <locationY>240</locationY>
        <assignmentItems>
            <assignToReference>$Record.Shipped_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
    </assignments>

    <!-- ── Assignment: set Delivered_Date__c = now ──────────────────────────── -->
    <assignments>
        <name>Stamp_Delivered_Date</name>
        <label>Stamp Delivered Date</label>
        <locationX>296</locationX>
        <locationY>240</locationY>
        <assignmentItems>
            <assignToReference>$Record.Delivered_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
    </assignments>

    <status>Active</status>
</Flow>
