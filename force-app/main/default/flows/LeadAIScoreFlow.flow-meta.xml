<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>Triggered after a new Web Lead is created. Calls LeadScoringWriter to compute AI score and write AIScore__c + AIReason__c.</description>
    <label>Lead AI Score Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>ScoreLead</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsConverted</field>
            <operator>EqualTo</operator>
            <value><booleanValue>false</booleanValue></value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>

    <!-- ── Call LeadScoringWriter Apex action ── -->
    <actionCalls>
        <name>ScoreLead</name>
        <label>Score Lead with AI</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <actionName>LeadScoringWriter</actionName>
        <actionType>apex</actionType>
        <inputParameters>
            <name>leadId</name>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>einsteinJson</name>
            <value><stringValue></stringValue></value>
        </inputParameters>
    </actionCalls>
</Flow>
