<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>Triggers portal user creation and credentials email when a Lead is converted.</description>
    <label>Nexus Portal Provisioning Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Provision_Portal_User</targetReference>
        </connector>
        <filterFormula>{!$Record.IsConverted} = TRUE &amp;&amp; {!$Record__Prior.IsConverted} = FALSE</filterFormula>
        <object>Lead</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <actionCalls>
        <name>Provision_Portal_User</name>
        <label>Provision Portal User</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <actionName>LeadManagementController</actionName>
        <actionType>apex</actionType>
        <inputParameters>
            <name>leadIds</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <status>Active</status>
</Flow>
