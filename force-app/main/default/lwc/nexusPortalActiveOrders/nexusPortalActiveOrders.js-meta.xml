<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__RecordPage,lightning__HomePage,lightningCommunity__Default">
            <property name="cardTitle"     type="String" label="Card Title"         default="Commandes Actives"/>
            <property name="ordersCount"   type="String" label="Orders Count"       default="12"/>
            <property name="ordersLabel"   type="String" label="Orders Label"       default="Commandes en cours"/>
            <property name="savingsAmount" type="String" label="Savings Amount"     default="$2,450"/>
            <property name="savingsLabel"  type="String" label="Savings Label"      default="Économies Réalisées"/>
            <property name="responseTime"  type="String" label="Response Time"      default="1.2h"/>
            <property name="responseLabel" type="String" label="Response Label"     default="Temps de Réponse Moy."/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
