<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__RecordPage,lightning__HomePage">
            <property name="leadId"   type="String"  label="Lead ID"        description="Salesforce Lead record Id"/>
            <property name="leadName" type="String"  label="Lead Name"      description="Full name of the lead"/>
            <property name="company"  type="String"  label="Company"        description="Company / account name"/>
            <property name="initials" type="String"  label="Initials"       description="1-2 character initials"/>
            <property name="score"    type="Integer" label="AI Lead Score"  description="Score 0-100" default="0"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
