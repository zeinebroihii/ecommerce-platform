<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <!-- App Builder + Community Default (component on a page) both support properties -->
        <targetConfig targets="lightning__AppPage,lightning__RecordPage,lightning__HomePage,lightningCommunity__Default">
            <property name="productId"          type="String"  label="Product ID"           description="Salesforce Product2 Id"/>
            <property name="productName"        type="String"  label="Product Name"         description="Name of the product" default="Mon Produit"/>
            <property name="productDescription" type="String"  label="Description"          description="Short product description"/>
            <property name="productFamily"      type="String"  label="Family"               description="e.g. Hardware, Networking, IoT" default="Hardware"/>
            <property name="imageUrl"           type="String"  label="Image URL"            description="Public image URL"/>
            <property name="unitPrice"          type="String"  label="Unit Price"           description="Price e.g. 1299.00" default="0"/>
            <property name="quantityAvailable"  type="String"  label="Quantity Available"   description="Stock quantity" default="10"/>
            <property name="isOutOfStock"       type="Boolean" label="Out of Stock"         description="Mark as out of stock" default="false"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
