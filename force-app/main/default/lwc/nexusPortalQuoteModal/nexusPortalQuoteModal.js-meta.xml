<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__RecordPage,lightning__HomePage,lightningCommunity__Default">
            <property name="isVisible"             type="Boolean" label="Visible"                description="Show or hide the modal" default="true"/>
            <property name="isLoading"             type="Boolean" label="Loading State"          description="Show spinner (true) or result (false)" default="false"/>
            <property name="quoteId"               type="String"  label="Quote ID"               description="e.g. QT-2024-001" default="QT-2024-001"/>
            <property name="discountPercent"       type="String"  label="Discount %"             description="Discount applied e.g. 10" default="0"/>
            <property name="paymentTerms"          type="String"  label="Payment Terms"          description="e.g. Net 30" default="Net 30"/>
            <property name="validUntil"            type="String"  label="Valid Until"            description="Validity display e.g. +30 jours" default="+30 jours"/>
            <property name="quoteTotal"            type="String"  label="Quote Total"            description="Numeric total e.g. 4500" default="0"/>
            <property name="acceptanceProbability" type="String"  label="Acceptance Probability" description="AI prediction 0-100" default="85"/>
            <property name="recipientEmail"        type="String"  label="Recipient"              description="Email shown in subtitle" default="votre compte"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
