<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__RecordPage,lightning__HomePage">
            <property name="productId"     type="String"  label="Product ID"      description="Salesforce Product2 record Id"/>
            <property name="productName"   type="String"  label="Product Name"    description="Product name"/>
            <property name="family"        type="String"  label="Family"          description="Product family / category"/>
            <property name="formattedPrice" type="String" label="Price"           description="Formatted price e.g. 299 €"/>
            <property name="stock"         type="Integer" label="Stock"           description="Current stock quantity" default="0"/>
            <property name="capacity"      type="Integer" label="Capacity"        description="Maximum stock capacity" default="100"/>
            <property name="status"        type="String"  label="Status"          description="Critical | Overstock | Optimal" default="Optimal"/>
            <property name="imageUrl"      type="String"  label="Image URL"       description="Product image URL"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
