<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__RecordPage,lightning__HomePage">
            <property name="itemId"             type="String"  label="Item ID"          description="Unique cart item identifier"/>
            <property name="productId"          type="String"  label="Product ID"       description="Salesforce Product2 Id"/>
            <property name="productName"        type="String"  label="Product Name"     description="Name of the product"/>
            <property name="productDescription" type="String"  label="Description"      description="Short product description"/>
            <property name="imageUrl"           type="String"  label="Image URL"        description="Product image URL"/>
            <property name="unitPrice"          type="String"  label="Unit Price"       description="Price per unit e.g. 299.00"/>
            <property name="quantity"           type="Integer" label="Quantity"         description="Number of units in cart" default="1"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
