<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__RecordPage,lightning__HomePage">
            <property name="orderId"        type="String"  label="Order ID"     description="Salesforce Order Id"/>
            <property name="orderNumber"    type="String"  label="Order Number" description="Order number"/>
            <property name="account"        type="String"  label="Account"      description="Account name"/>
            <property name="orderDate"      type="String"  label="Order Date"   description="Order effective date"/>
            <property name="formattedTotal" type="String"  label="Total"        description="Formatted total"/>
            <property name="status"         type="String"  label="Status"       description="Draft | Activated"/>
            <property name="itemCount"      type="Integer" label="Item Count"   description="Number of items" default="0"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
